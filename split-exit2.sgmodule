#!name=分流出口检测
#!desc=自制分流出口面板：上半部是分站出口（ChatGPT、Claude、Binance、Spotify、Cloudflare 按现行分流规则实际走的出口 IP 与归属地），下半部是分组出口（把查询钉到各策略组看当前真实出口，含 DIRECT 本机真实出口）。数据来源为 Cloudflare Trace 与 ipwho.is，与 ipfinal 无关（它家 API 拦脚本客户端）。脚本自托管在自己的仓库。
#!category=网络检测
#!icon=network
#!arguments=分组:Proxy|🇭🇰Hong Kong|🇯🇵Japan|🇸🇬Singapore|🇺🇸America|AIGC
#!arguments-desc=策略组名用 | 分隔，逐个强制探测出口，组名照抄配置里的原文（含国旗）；DIRECT 真实出口恒在第一行，不用填。

[Panel]
分流出口 = title="分流出口",content="正在探测分站与分组出口…",style=info,script-name=分流出口检测,update-interval=900

[Script]
分流出口检测 = type=generic,script-path=https://raw.githubusercontent.com/xchun5678/surge/main/split-exit-panel2.js,script-update-interval=86400,argument="{{{分组}}}",timeout=30
