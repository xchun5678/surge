# NAME: Telegram_All
# AUTHOR: mickeu
# REPO: https://github.com/mickeu/surge
# DESCRIPTION: Telegram 完整规则集（合并 blackmatrix7 Telegram.list + TelegramSG.list + ASN.Telegram.list + 补充 CDN 域名）
# 来源：
#   - https://github.com/blackmatrix7/ios_rule_script (Telegram.list / TelegramSG.list)
#   - https://github.com/VirgilClyne/GetSomeFries (ASN.Telegram.list)

# --- DOMAIN (精确域名) ---
DOMAIN,api.imem.app
DOMAIN,api.swiftgram.app
# --- DOMAIN-SUFFIX (域名后缀) ---
DOMAIN-SUFFIX,comments.app
DOMAIN-SUFFIX,contest.com
DOMAIN-SUFFIX,graph.org
DOMAIN-SUFFIX,legra.ph
DOMAIN-SUFFIX,mbrx.app
DOMAIN-SUFFIX,quiz.directory
DOMAIN-SUFFIX,stel.com
DOMAIN-SUFFIX,t.me
DOMAIN-SUFFIX,tdesktop.com
DOMAIN-SUFFIX,telega.one
DOMAIN-SUFFIX,telegra.ph
DOMAIN-SUFFIX,telegram.dog
DOMAIN-SUFFIX,telegram.me
DOMAIN-SUFFIX,telegram.org
DOMAIN-SUFFIX,telegram.space
DOMAIN-SUFFIX,telegramdownload.com
DOMAIN-SUFFIX,telesco.pe
DOMAIN-SUFFIX,tg.dev
DOMAIN-SUFFIX,tx.me
DOMAIN-SUFFIX,usercontent.dev
# --- DOMAIN-KEYWORD ---
DOMAIN-KEYWORD,nicegram
# --- IP-CIDR (Telegram 服务器) ---
IP-CIDR,91.108.0.0/16,no-resolve
IP-CIDR,91.108.16.0/22,no-resolve
IP-CIDR,91.108.56.0/22,no-resolve
IP-CIDR,109.239.140.0/24,no-resolve
IP-CIDR,149.154.160.0/20,no-resolve
IP-CIDR,5.28.192.0/18,no-resolve
IP-CIDR,139.59.210.98/32,no-resolve
IP-CIDR,196.55.216.167/32,no-resolve
# --- IP-CIDR6 (Telegram IPv6) ---
IP-CIDR6,2001:67c:4e8::/48,no-resolve
IP-CIDR6,2001:b28:f23c::/47,no-resolve
IP-CIDR6,2001:b28:f23f::/48,no-resolve
IP-CIDR6,2a0a:f280::/29,no-resolve
IP-CIDR6,2a0a:f280::/32,no-resolve
# --- IP-ASN (Telegram 自治域) ---
IP-ASN,44907,no-resolve
IP-ASN,59930,no-resolve
IP-ASN,62014,no-resolve
IP-ASN,62041,no-resolve
IP-ASN,211157,no-resolve
# --- PROCESS-NAME (客户端进程) ---
PROCESS-NAME,nekox.messenger
PROCESS-NAME,org.telegram.messenger
PROCESS-NAME,telegram-desktop
PROCESS-NAME,tw.nekomimi.nekogram
PROCESS-NAME,xyz.nextalone.nagram
# --- OR (ASN 逻辑或) ---
OR,((IP-ASN,44907,no-resolve),(IP-ASN,59930,no-resolve),(IP-ASN,62014,no-resolve),(IP-ASN,62041,no-resolve),(IP-ASN,211157,no-resolve))