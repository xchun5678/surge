#!name=中国移动（Surge 面板版）
#!desc=话费 / 流量 / 语音余量面板 + 登录捕获 + 会话保活。先在「中国移动」App 用短信验证码登录一次自动捕获参数，之后面板自动查询：剩余话费、通用/其他流量、剩余语音，附今日已用、日均可用、用完预测与近 7 天用量条。基于 Aswoth/Hark 的 Egern 版（china-mobile-hark-merged-glass）适配：数据层（自研 MD5/AES 加解密、签名、autoLogin 续期、用量洞察）逻辑原样搬运，渲染换成 Surge 文字面板。脚本自托管在自己的仓库。
#!author=xchun5678（Surge 适配） / 原作 Hark、zhaohantao1360-hash（Egern 版）
#!category=网络
#!icon=antenna.radiowaves.left.and.right
#!homepage=https://github.com/Aswoth/Egern--Widget
#!arguments=CM_PHONENUMBER:选填,CM_CAPTURE:true,CM_CAPTURE_NOTIFY:false,CM_TITLE:中国移动,CM_SHOW_USED_FLOW:false,CM_DEBUG:false
#!arguments-desc=\n📌 参数说明\n\n1️⃣ CM_PHONENUMBER 手机号（选填）\n11 位移动手机号；不填则用已保存的号码（抓参数时用的那个号）\n\n2️⃣ CM_CAPTURE 抓取登录信息（默认 true）\n打开「中国移动」App 时自动更新登录信息。关掉后不再抓取，登录过期也不会自动恢复（过期需重新打开）\n\n3️⃣ CM_CAPTURE_NOTIFY 每次抓取都通知（默认 false）\n默认只在第一次抓到或登录过期恢复时通知；改 true 每次抓到都弹通知\n\n4️⃣ CM_TITLE 面板标题（选填）\n默认「中国移动」\n\n5️⃣ CM_SHOW_USED_FLOW 显示已用流量（默认 false）\nfalse 显示剩余流量，true 显示已用流量\n\n6️⃣ CM_DEBUG 调试信息（默认 false）\ntrue 时面板末尾附接口结构调试行，排查问题用\n\n📝 使用方法\n装好模块后，打开「中国移动」App 用短信验证码登录一次（建议关掉指纹/面容登录），收到「登录参数捕获成功」通知即完成；之后面板点刷新即可。保活脚本每 20 分钟自动查一次防会话被注销。\n\n⚠️ 参数传入说明\n参数会以 & 连接传入脚本（CM_PHONENUMBER=xxx&CM_CAPTURE=true&…），脚本自行解析。改完参数后必须 reload（Surge 配置→Reload Profile）让脚本重新加载。

[Script]
中国移动面板 = type=generic,script-path=https://raw.githubusercontent.com/xchun5678/surge/main/china-mobile-panel2.js,script-update-interval=86400,timeout=30,argument=CM_PHONENUMBER={{{CM_PHONENUMBER}}}&CM_TITLE={{{CM_TITLE}}}&CM_SHOW_USED_FLOW={{{CM_SHOW_USED_FLOW}}}&CM_DEBUG={{{CM_DEBUG}}}
中国移动登录捕获 = type=http-request,pattern=^https?:\/\/(client\.app\.coc\.10086\.cn|10086\.online-cmcc\.cn)(:\d+)?\/,requires-body=true,script-path=https://raw.githubusercontent.com/xchun5678/surge/main/china-mobile-panel2.js,script-update-interval=86400,timeout=30,argument=CM_CAPTURE={{{CM_CAPTURE}}}&CM_CAPTURE_NOTIFY={{{CM_CAPTURE_NOTIFY}}}
中国移动Cookie捕获 = type=http-response,pattern=^https?:\/\/(client\.app\.coc\.10086\.cn|10086\.online-cmcc\.cn)(:\d+)?\/,script-path=https://raw.githubusercontent.com/xchun5678/surge/main/china-mobile-panel2.js,script-update-interval=86400,timeout=30,argument=CM_CAPTURE={{{CM_CAPTURE}}}&CM_CAPTURE_NOTIFY={{{CM_CAPTURE_NOTIFY}}}
中国移动保活 = type=cron,cronexp="*/20 * * * *",script-path=https://raw.githubusercontent.com/xchun5678/surge/main/china-mobile-panel2.js,script-update-interval=86400,timeout=60,argument=CM_KEEPALIVE=true&CM_PHONENUMBER={{{CM_PHONENUMBER}}}

[Panel]
中国移动 = script-name=中国移动面板,title="中国移动",content="点击刷新",style=info,icon=antenna.radiowaves.left.and.right,icon-color=#009FE8,update-interval=0

[MITM]
hostname = %APPEND% client.app.coc.10086.cn, 10086.online-cmcc.cn
