#!name=小红书/RedNote 去水印去广告(海外版·水印拦截法)
#!desc=采用 QingRex 思路：Map Local 拦截 watermark 水印配置接口，让红书客户端拿不到水印配置，从而所有图片(含评论区)无死角去水印。适配海外版 RedNote(rnote.com)。
#!author=xchun5678
#!homepage=https://github.com/xchun5678/surge

[Rule]
# 屏蔽 QUIC 让红书走可处理的 HTTP
AND,((PROTOCOL,QUIC), (DOMAIN-SUFFIX,rnote.com)),REJECT
AND,((PROTOCOL,QUIC), (DOMAIN-SUFFIX,xhscdn.com)),REJECT
AND,((PROTOCOL,QUIC), (DOMAIN-SUFFIX,rednotecan.com)),REJECT
# 红书 CDN 直连
DOMAIN-SUFFIX,rednotecan.com,DIRECT
DOMAIN-SUFFIX,xhscdn.com,DIRECT
DOMAIN-SUFFIX,rnote.com,DIRECT

[Map Local]
# 拦截水印配置接口（QingRex 方法核心）→ 客户端拿不到水印，全图无死角去水印
^https:\/\/ci\.xiaohongshu\.com\/system_config\/watermark data-type=tiny-gif status-code=200
^https:\/\/ci\.rnote\.com\/system_config\/watermark data-type=tiny-gif status-code=200
^https:\/\/edith\.(?:xiaohongshu|rnote)\.com\/api\/sns\/v1\/system\/config\/watermark data-type=tiny-gif status-code=200
^https:\/\/www\.(?:xiaohongshu|rnote)\.com\/api\/sns\/v1\/system_config\/watermark data-type=tiny-gif status-code=200
# 拦截广告配置接口
^https:\/\/ci\.(?:xiaohongshu|rnote)\.com\/system_config\/(?:advertise|splash) data-type=tiny-gif status-code=200

[Script]
# ===== 去广告/去水印（保留 RedPaper 核心能力，覆盖海外版 rnote 域名） =====
RedPaper_remove_ads.js = script-path=https://kelee.one/Resource/JavaScript/RedPaper/RedPaper_remove_ads.js,requires-body=true,tag=移除图片和实况照片水印,type=http-response,pattern=^https:\/\/edith\.rnote\.com\/api\/sns\/v1\/note\/(?:imagefeed|live_photo\/save)(\?|$)
RedPaper_remove_ads.js = script-path=https://kelee.one/Resource/JavaScript/RedPaper/RedPaper_remove_ads.js,requires-body=true,tag=移除界面配置,type=http-response,pattern=^https:\/\/edith\.rnote\.com\/api\/sns\/v1\/system\/service\/ui\/config\?
RedPaper_remove_ads.js = script-path=https://kelee.one/Resource/JavaScript/RedPaper/RedPaper_remove_ads.js,requires-body=true,tag=移除开屏广告,type=http-response,pattern=^https:\/\/edith\.rnote\.com\/api\/sns\/v1\/system_service\/config\?
RedPaper_remove_ads.js = script-path=https://kelee.one/Resource/JavaScript/RedPaper/RedPaper_remove_ads.js,requires-body=true,tag=移除开屏splash,type=http-response,pattern=^https:\/\/edith\.rnote\.com\/api\/sns\/v2\/system_service\/splash_config
RedPaper_remove_ads.js = script-path=https://kelee.one/Resource/JavaScript/RedPaper/RedPaper_remove_ads.js,requires-body=true,tag=移除详情页小部件,type=http-response,pattern=^https:\/\/edith\.rnote\.com\/api\/sns\/v2\/(?:note\/widgets|user\/followings\/followfeed)
RedPaper_remove_ads.js = script-path=https://kelee.one/Resource/JavaScript/RedPaper/RedPaper_remove_ads.js,requires-body=true,tag=移除信息流广告,type=http-response,pattern=^https:\/\/edith\.rnote\.com\/api\/sns\/v4\/followfeed\?
RedPaper_remove_ads.js = script-path=https://kelee.one/Resource/JavaScript/RedPaper/RedPaper_remove_ads.js,requires-body=true,tag=移除详情页感兴趣的人,type=http-response,pattern=^https:\/\/edith\.rnote\.com\/api\/sns\/v5\/recommend\/user\/follow_recommend\?
RedPaper_remove_ads.js = script-path=https://kelee.one/Resource/JavaScript/RedPaper/RedPaper_remove_ads.js,requires-body=true,tag=移除评论区实况照片水印,type=http-response,pattern=^https:\/\/edith\.rnote\.com\/api\/sns\/(?:v1\/interaction\/comment\/video\/download|v5\/note\/comment\/list)
RedPaper_remove_ads.js = script-path=https://kelee.one/Resource/JavaScript/RedPaper/RedPaper_remove_ads.js,requires-body=true,tag=移除图片视频水印,type=http-response,pattern=^https:\/\/edith\.rnote\.com\/api\/sns\/(?:v2\/note\/feed|v3\/note\/videofeed)
RedPaper_remove_ads.js = script-path=https://kelee.one/Resource/JavaScript/RedPaper/RedPaper_remove_ads.js,requires-body=true,tag=移除信息流广告,type=http-response,pattern=^https:\/\/(?:edith|rec)\.rnote\.com\/api\/sns\/v6\/homefeed\?
RedPaper_remove_ads.js = script-path=https://kelee.one/Resource/JavaScript/RedPaper/RedPaper_remove_ads.js,requires-body=true,tag=移除搜索页广告,type=http-response,pattern=^https:\/\/(?:edith|so)\.rnote\.com\/api\/sns\/v10\/search\/notes\?
RedPaper_remove_ads.js = script-path=https://kelee.one/Resource/JavaScript/RedPaper/RedPaper_remove_ads.js,requires-body=true,tag=移除视频水印,type=http-response,pattern=^https:\/\/(?:edith|rec|www)\.rnote\.com\/api\/sns\/(?:v4\/note\/videofeed|v10\/note\/video\/save)

[MITM]
hostname = %APPEND% ci.xiaohongshu.com, ci.rnote.com, edith.rnote.com, rec.rnote.com, so.rnote.com, www.rnote.com, music.rnote.com, *.xhscdn.com, *.rednotecan.com